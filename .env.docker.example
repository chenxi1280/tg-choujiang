BOT_TOKEN=123456789:replace-with-real-token
OPS_BOT_TOKEN=
OPS_BOT_ID=
# Only these Telegram users or enabled database winner_designation_operators may designate winners.
# An empty value grants nobody via configuration; ordinary ADMIN_IDS and group admins do not qualify.
OPS_ADMIN_IDS=
DATABASE_URL=postgresql+asyncpg://tg_lottery:change-me@app-infra-postgres:5432/tg_lottery
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_IDS=123456789
TIMEZONE=Asia/Shanghai
GUIDE_CHANNEL_URL=
NAVIGATION_CHANNEL_URL=
FEATURED_CHANNEL_URL=
# New campaigns require navigation + featured; frozen official-v1 campaigns keep three targets.
# Enable after confirming both stable channel identities and bot administrator rights.
PLATFORM_REQUIRED_ENABLED=false
PLATFORM_POLICY_VERSION=official-v2
PLATFORM_OFFICIAL_CHANNELS=[]
PLATFORM_OBSERVATION_MAX_AGE_SECONDS=300
LOG_LEVEL=INFO
POLL_TIMEOUT_SECONDS=30
POLL_LEASE_SECONDS=60
WORKER_POLL_SECONDS=2
QUALIFICATION_REQUESTS_PER_SECOND=20
INFRA_NETWORK_NAME=infra_default
TG_LOTTERY_APP_IMAGE=tg-lottery-app:latest
TG_LOTTERY_HEALTH_TIMEOUT_SECONDS=600
